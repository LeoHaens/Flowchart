{"schema":1,"rev":"beispiel-1","nodes":[{"id":"start","type":"terminal","x":-72,"y":0,"w":144,"h":40,"title":"Kühlschrank auf","info":"","note":"","parent":null},{"id":"inventur","type":"group","x":-104,"y":88,"w":400,"h":56,"title":"Reste-Inventur","info":"3 Reste · 1 Prüfung","note":"","parent":null,"collapsed":false,"portX":104},{"id":"r-eier","type":"note","x":16,"y":80,"w":112,"h":64,"title":"Eier","info":"hält ~1 Woche","note":"Hart gekocht, vom Frühstück übrig.","parent":"inventur"},{"id":"r-kartoffeln","type":"note","x":144,"y":80,"w":112,"h":64,"title":"Kartoffeln","info":"hält 3–4 Tage","note":"Gekocht, von der Beilage übrig.","parent":"inventur"},{"id":"r-graupen","type":"note","x":272,"y":80,"w":112,"h":64,"title":"Graupen","info":"hält 3–4 Tage","note":"Gekocht, vom Vortag übrig.","parent":"inventur"},{"id":"check","type":"decision","x":32,"y":184,"w":144,"h":88,"title":"Alles noch gut?","info":"","note":"Riechen und anschauen. Faustregel: Gekochtes hält im Kühlschrank 3–4 Tage, hart gekochte Eier mit Schale etwa eine Woche.","parent":"inventur"},{"id":"bio","type":"terminal","x":224,"y":208,"w":136,"h":40,"title":"Biomüll","info":"","note":"Im Zweifel weg damit.","parent":"inventur","variant":"exit"},{"id":"extras","type":"group","x":-104,"y":432,"w":400,"h":56,"title":"Ein paar Sachen dazu","info":"6 Zutaten","note":"","parent":null,"collapsed":true,"portX":104},{"id":"i-speck","type":"step","x":16,"y":80,"w":112,"h":56,"title":"Speck","info":"150 g","note":"Gewürfelt.","parent":"extras","variant":"item"},{"id":"i-zwiebel","type":"step","x":144,"y":80,"w":112,"h":56,"title":"Zwiebel","info":"1 Stück","note":"","parent":"extras","variant":"item"},{"id":"i-karotten","type":"step","x":272,"y":80,"w":112,"h":56,"title":"Karotten","info":"2 Stück","note":"","parent":"extras","variant":"item"},{"id":"i-lauch","type":"step","x":16,"y":152,"w":112,"h":56,"title":"Lauch","info":"1 Stange","note":"","parent":"extras","variant":"item"},{"id":"i-bruehe","type":"step","x":144,"y":152,"w":112,"h":56,"title":"Brühe","info":"1,5 l","note":"","parent":"extras","variant":"item"},{"id":"i-gewuerze","type":"step","x":272,"y":152,"w":112,"h":56,"title":"Gewürze","info":"nach Gefühl","note":"Salz, Pfeffer, Majoran, Lorbeer.","parent":"extras","variant":"item"},{"id":"basis","type":"group","x":-104,"y":536,"w":400,"h":56,"title":"Basis kochen","info":"4 Schritte · ca. 25 min","note":"","parent":null,"collapsed":true,"portX":104},{"id":"speck","type":"step","x":24,"y":80,"w":160,"h":72,"title":"Speck auslassen","info":"5 min","note":"In den kalten Topf, ohne Öl, bei mittlerer Hitze. Das Fett, das dabei austritt, ist gleich das Bratfett fürs Gemüse.","parent":"basis"},{"id":"gemuese","type":"step","x":24,"y":184,"w":160,"h":72,"title":"Gemüse anschwitzen","info":"5 min","note":"Zwiebel, Karotten und Lauch klein schneiden und im Speckfett glasig werden lassen.","parent":"basis"},{"id":"aufgiessen","type":"step","x":24,"y":288,"w":160,"h":72,"title":"Mit Brühe aufgießen","info":"1,5 l","note":"Ein Lorbeerblatt und eine Prise Majoran dazu.","parent":"basis"},{"id":"koecheln","type":"step","x":24,"y":392,"w":160,"h":72,"title":"Köcheln lassen","info":"15 min","note":"Halb zugedeckt, bis die Karotten weich sind.","parent":"basis"},{"id":"resterein","type":"group","x":-104,"y":640,"w":400,"h":56,"title":"Reste rein","info":"3 Schritte · ca. 10 min","note":"","parent":null,"collapsed":true,"portX":104},{"id":"graupen","type":"step","x":24,"y":80,"w":160,"h":72,"title":"Graupen einrühren","info":"5 min","note":"Sie saugen Flüssigkeit auf. Wird die Suppe zu dick, einen Schuss Wasser nachgießen.","parent":"resterein"},{"id":"kartoffeln","type":"step","x":24,"y":184,"w":160,"h":72,"title":"Kartoffeln dazu","info":"3 min","note":"In Würfel schneiden. Ein paar mit dem Schöpfer zerdrücken, das bindet die Suppe.","parent":"resterein"},{"id":"eier","type":"decision","x":32,"y":288,"w":144,"h":88,"title":"Eier schon gekocht?","info":"","note":"","parent":"resterein"},{"id":"roh","type":"step","x":224,"y":296,"w":152,"h":72,"title":"Einlaufen lassen","info":"1 min","note":"Verquirlen und in dünnem Strahl in die leise köchelnde Suppe gießen. Kurz stocken lassen, dann umrühren. Das gibt Eierflocken wie bei der Einlaufsuppe.","parent":"resterein"},{"id":"gekocht","type":"step","x":24,"y":408,"w":160,"h":72,"title":"Würfeln, unterheben","info":"1 min","note":"Erst ganz zum Schluss, sonst werden sie gummig.","parent":"resterein"},{"id":"join","type":"join","x":96,"y":504,"w":16,"h":16,"title":"","info":"","note":"","parent":"resterein"},{"id":"kosten","type":"decision","x":-72,"y":744,"w":144,"h":88,"title":"Kosten. Passt’s?","info":"","note":"","parent":null},{"id":"nachwuerzen","type":"step","x":120,"y":752,"w":152,"h":72,"title":"Nachwürzen","info":"nach Gefühl","note":"Salz, Pfeffer, Majoran. Ein Schuss Essig macht die Kartoffeln frischer, Hefeflocken bringen Würze ohne extra Salz.","parent":null},{"id":"servieren","type":"step","x":-80,"y":880,"w":160,"h":72,"title":"Servieren","info":"mit Salat","note":"Tiefe Teller, großer Schöpfer. Dazu Tomaten-Rucola-Salat und Hefeflocken zum Drüberstreuen.","parent":null},{"id":"topf","type":"decision","x":-72,"y":1000,"w":144,"h":88,"title":"Topf leer?","info":"","note":"","parent":null},{"id":"kuehlschrank","type":"step","x":120,"y":1008,"w":152,"h":72,"title":"Ab in den Kühlschrank","info":"hält 3–4 Tage","note":"Laut Foto ist noch einiges übrig. Abgedeckt und innerhalb von 2 Stunden kalt stellen. Die Graupen quellen nach, beim Aufwärmen also Wasser dazugeben.","parent":null},{"id":"ende","type":"terminal","x":-72,"y":1136,"w":144,"h":40,"title":"Mahlzeit!","info":"","note":"","parent":null},{"id":"todo","type":"note","x":120,"y":1112,"w":152,"h":88,"title":"Offener Punkt","info":"","note":"Wer wäscht den Topf ab?","parent":null}],"edges":[{"id":"e1","from":"start","to":"inventur","label":""},{"id":"e2","from":"r-eier","to":"check","label":""},{"id":"e3","from":"r-kartoffeln","to":"check","label":""},{"id":"e4","from":"r-graupen","to":"check","label":""},{"id":"e5","from":"check","to":"bio","label":"Nein"},{"id":"e6","from":"check","to":"extras","label":"Ja"},{"id":"e7","from":"extras","to":"speck","label":""},{"id":"e8","from":"speck","to":"gemuese","label":""},{"id":"e9","from":"gemuese","to":"aufgiessen","label":""},{"id":"e10","from":"aufgiessen","to":"koecheln","label":""},{"id":"e11","from":"koecheln","to":"graupen","label":""},{"id":"e12","from":"graupen","to":"kartoffeln","label":""},{"id":"e13","from":"kartoffeln","to":"eier","label":""},{"id":"e14","from":"eier","to":"gekocht","label":"Ja"},{"id":"e15","from":"eier","to":"roh","label":"Nein"},{"id":"e16","from":"gekocht","to":"join","label":""},{"id":"e17","from":"roh","to":"join","label":"","fromSide":"bottom","toSide":"right"},{"id":"e18","from":"join","to":"kosten","label":""},{"id":"e19","from":"kosten","to":"servieren","label":"Ja"},{"id":"e20","from":"kosten","to":"nachwuerzen","label":"Nein"},{"id":"e21","from":"nachwuerzen","to":"kosten","label":"nochmal kosten","fromSide":"top","toSide":"top"},{"id":"e22","from":"servieren","to":"topf","label":""},{"id":"e23","from":"topf","to":"ende","label":"Ja"},{"id":"e24","from":"topf","to":"kuehlschrank","label":"Nein"},{"id":"e25","from":"kuehlschrank","to":"start","label":"Rest von morgen","fromSide":"right","toSide":"right"}]}